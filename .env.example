# Application
PROJECT_NAME=FastAPI Async Template
VERSION=3.0.0
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security (change in production!)
SECRET_KEY=replace-with-a-secure-secret-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (primary)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_db
# Read-replica (optional — falls back to DATABASE_URL when unset)
# DATABASE_URL_READER=postgresql+asyncpg://postgres:postgres@localhost:5433/fastapi_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# File Storage (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# OpenTelemetry (only needed in production)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# Event Bus
EVENT_BUS_BACKEND=redis
EVENT_BUS_REDIS_URL=
EVENT_BUS_KAFKA_SERVERS=localhost:9092

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RELYING_PARTY_ID=localhost
WEBAUTHN_RP_NAME=FastAPI Async Template
WEBAUTHN_ORIGIN=http://localhost:8000

# Performance
SLOW_QUERY_THRESHOLD_MS=500

# Feature Flags (set to "1", "true", or "yes" to enable; "0", "false", "no" to disable)
FEATURE_WEBAUTHN=true
FEATURE_GRAPHQL_SUBSCRIPTIONS=true
FEATURE_ADMIN_DASHBOARD=true
FEATURE_MULTI_TENANCY=true
FEATURE_FULL_TEXT_SEARCH=true
FEATURE_AUDIT_LOGGING=true

# Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_db
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8000
